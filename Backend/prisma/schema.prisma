// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id           Int    @id @default(autoincrement())
  email        String @unique
  cnpj         String @unique
  name         String
  reason       String
  socialReason String
  password     String
  phoneNumber  String @unique

  cep          String
  neighborhood String
  city         String
  state        String
  numberHouse  String
  street       String

  pushToken String? // Token do Expo para push notifications

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards Card[]
}

model Card {
  id            Int             @id @default(autoincrement())
  createAt      DateTime        @default(now())
  updateAt      DateTime        @updatedAt
  title         String          @db.VarChar(255)
  description   String?
  owner         Institution     @relation(fields: [ownerId], references: [id])
  ownerId       Int
  banner        String?
  startAt       DateTime
  duration      Int // duração em minutos (max 1439 = 23h59m)
  isOnline      Boolean         @default(false)
  cep           String?
  neighborhood  String?
  city          String?
  state         String?
  numberHouse   String?
  street        String?
  complement    String?
  locationNote  String?
  maxVolunteers Int
  status        CardStatus      @default(ACTIVE)
  skills        Skill[]
  participants  Participation[]
}

model Voluntary {
  id          Int    @id @default(autoincrement())
  email       String @unique
  name        String
  password    String
  phoneNumber String @unique

  cep   String
  city  String
  state String

  pushToken String? // Token do Expo para push notifications

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills       Skill[]
  participants Participation[]
}

model Skill {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  volunteers Voluntary[]
  cards      Card[]
}

model Participation {
  id          Int                 @id @default(autoincrement())
  voluntary   Voluntary           @relation(fields: [voluntaryId], references: [id])
  voluntaryId Int
  card        Card                @relation(fields: [cardId], references: [id])
  cardId      Int
  status      ParticipationStatus @default(PENDING)
  observation String?

  @@unique([voluntaryId, cardId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int // ID do voluntário ou instituição
  userType  UserType // VOLUNTARY ou INSTITUTION
  type      NotificationType // Tipo da notificação
  title     String
  message   String
  cardId    Int? // Opcional: referência ao card relacionado
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum CardStatus {
  ACTIVE
  PENDING
  FINALIZED
  CANCELED
}

enum ParticipationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum UserType {
  VOLUNTARY
  INSTITUTION
}

enum NotificationType {
  NEW_OPPORTUNITY // Nova oportunidade criada (para voluntários)
  NEW_APPLICATION // Nova inscrição recebida (para instituição)
  APPLICATION_APPROVED // Inscrição aprovada (para voluntário)
  APPLICATION_REJECTED // Inscrição rejeitada (para voluntário)
  OPPORTUNITY_CANCELED // Oportunidade cancelada (para voluntário)
  OPPORTUNITY_STARTING // Oportunidade começando em 1h (para voluntário)
}
